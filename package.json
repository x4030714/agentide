{
  "name": "agentide",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-port.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:sidecar": "npm --prefix sidecar run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:release": "npm run build && npm run build:sidecar && npm run stage",
    "stage": "node scripts/stage-sidecar.mjs && node scripts/stage-tools.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:quick": "node scripts/smoke.mjs --no-turn",
    "agent": "node --experimental-strip-types sidecar/src/cli.ts",
    "stage:tools": "node scripts/stage-tools.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.0"
  },
  "bin": {
    "agentide": "sidecar/dist/cli.mjs"
  },
  "overrides": {
    "@xterm/addon-canvas": {
      "@xterm/xterm": "$@xterm/xterm"
    }
  }
}
