{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentide",
  "version": "0.1.0",
  "identifier": "com.tung.agentide",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run stage && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "agentide",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/main.mjs": "sidecar/main.mjs",
      "../sidecar/dist/node_modules": "sidecar/node_modules",
      "../src-tauri/tools": "tools"
    },
    "externalBin": [
      "binaries/node"
    ]
  }
}
